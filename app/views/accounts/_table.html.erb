<%# tickable: the expense accounts, each with a tick tied to the pairing form under the table. %>
<% tickable = local_assigns[:tickable] %>
<table class="data-table chart-table">
  <thead>
    <tr>
      <% if tickable %><th class="recode-tick"><input type="checkbox" aria-label="Tick every expense account" data-checklist-target="all" data-action="checklist#toggleAll"></th><% end %>
      <th style="width:80px">Code</th>
      <th>Name</th>
      <% if local_assigns[:show_type] %><th>Type</th><% end %>
      <th class="chart-description">Description</th>
      <th class="num">Balance</th>
      <th class="num"></th>
    </tr>
  </thead>
  <tbody>
    <% accounts.each do |account| %>
      <tr id="<%= dom_id(account) %>" class="<%= 'muted' if account.archived? %>">
        <% if tickable %>
          <td class="recode-tick">
            <%= check_box_tag "account_ids[]", account.id, false, id: nil, form: dom_id(Current.organization, :billing_income), "aria-label": "Tick #{account.name}",
                  data: { checklist_target: "box", action: "checklist#refresh" } %>
          </td>
        <% end %>
        <td data-label="Code"><%= account.code || content_tag(:span, "—", class: "muted") %></td>
        <td data-label="Name">
          <%= link_to account.name, reports_general_ledger_path(account_id: account.id), title: "Open #{account.name} in the general ledger" %>
          <% if account.billing_income_account %>
            <span class="muted chart-billed-as">bills as <%= [ account.billing_income_account.code, account.billing_income_account.name ].compact_blank.join(" ") %></span>
          <% end %>
          <% if account.bank_account %>
            <%= link_to account.bank_account.kind_label, edit_bank_account_path(account.bank_account), class: "badge badge-open", style: "margin-left:6px;text-decoration:none;" %>
          <% end %>
        </td>
        <% if local_assigns[:show_type] %><td data-label="Type"><%= account.type.demodulize %></td><% end %>
        <td data-label="Description" class="muted chart-description"><%= account.description %></td>
        <td data-label="Balance" class="num">$<%= number_with_precision(account.balance, precision: 2, delimiter: ",") %></td>
        <td class="num">
          <% if account.bank_account %>
            <%# A bank account's ledger side is archived and restored from Banking, through the badge beside its name. %>
          <% elsif account.archived? %>
            <%= link_to "Edit", edit_account_path(account), class: "btn btn-secondary" %>
            <%= button_to "Restore", restore_account_path(account), params: { q: @q.presence }.compact, class: "btn btn-secondary", form: { class: "inline-form", data: { turbo_stream: true } } %>
          <% else %>
            <%= link_to "Edit", edit_account_path(account), class: "btn btn-secondary" %>
            <%= button_to "Archive", archive_account_path(account), params: { q: @q.presence }.compact, class: "btn btn-secondary", form: { class: "inline-form", data: { turbo_stream: true } } %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
